<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE GroupDefinition PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<GroupDefinition indexed="true" name="IT Department Population" private="true">
  <Description/>
  <GroupFilter>
    <CompositeFilter operation="AND">
      <Filter matchMode="START" operation="LIKE" property="department" value="[IT]"/>
      <Filter matchMode="START" operation="LIKE" property="status" value="Active"/>
